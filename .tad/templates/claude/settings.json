{
  "hooks": {
    "SessionStart": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "test -n \"$CLAUDE_PROJECT_DIR\" && { cd -- \"$CLAUDE_PROJECT_DIR\" || exit 1; } && bash .tad/hooks/startup-health.sh", "timeout": 30 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "test -n \"$CLAUDE_PROJECT_DIR\" && { cd -- \"$CLAUDE_PROJECT_DIR\" || exit 1; } && bash .tad/hooks/post-write-sync.sh", "timeout": 10 } ] },
      { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "test -n \"$CLAUDE_PROJECT_DIR\" && { cd -- \"$CLAUDE_PROJECT_DIR\" || exit 1; } && bash .tad/hooks/lib/askuser-capture.sh", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "test -n \"$CLAUDE_PROJECT_DIR\" && { cd -- \"$CLAUDE_PROJECT_DIR\" || exit 1; } && bash .tad/hooks/precompact-session-snapshot.sh", "timeout": 10 } ] }
    ]
  }
}
