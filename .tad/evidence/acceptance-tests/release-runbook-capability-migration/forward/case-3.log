case "$origin" in
  https://github.com/Sheldon-92/TAD|https://github.com/Sheldon-92/TAD.git|git@github.com:Sheldon-92/TAD.git|ssh://git@github.com:Sheldon-92/TAD.git) ;;
  *) exit 1 ;;
esac
